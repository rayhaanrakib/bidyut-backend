# ============================================
# Server
# ============================================
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET=your_secure_access_secret
JWT_REFRESH_SECRET=your_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ============================================
# Google OAuth 2.0
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# Stripe
# ============================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CURRENCY=bdt
PRIORITY_RESTORATION_PRICE=99
SLA_SUBSCRIPTION_PRICE=499
SLA_SUBSCRIPTION_DAYS=30

# ============================================
# Redis
# ============================================
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your_redis_host
REDIS_PORT=6379

# ============================================
# SMTP
# ============================================
EMAIL_SENDER=your_email@example.com
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ============================================
# Cloudinary
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================
# BIDYUT feature rule
# ============================================
BULK_OUTAGE_THRESHOLD=5
BULK_OUTAGE_WINDOW_MINUTES=15
FEEDER_WEEKLY_LOAD_SHED_CAP_MINUTES=600
SLA_BREACH_HOURS=4
CRON_SECRET=change_this_cron_secret

# ============================================
# Auto-seeded demo accounts
# ============================================
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@bidyut.demo
SEED_ADMIN_PASSWORD=your_secure_admin_password

SEED_OPERATOR_NAME=Operator User
SEED_OPERATOR_EMAIL=operator@bidyut.demo
SEED_OPERATOR_PASSWORD=your_secure_operator_password

SEED_TECHNICIAN_NAME=Technician User
SEED_TECHNICIAN_EMAIL=technician@bidyut.demo
SEED_TECHNICIAN_PASSWORD=your_secure_technician_password

SEED_CUSTOMER_NAME=Demo Customer
SEED_CUSTOMER_EMAIL=customer@bidyut.demo
SEED_CUSTOMER_PASSWORD=your_secure_customer_password
