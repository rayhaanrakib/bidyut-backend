{
  "name": "bidyut-backend",
  "version": "1.0.0",
  "description": "Load Shedding & Power Outage Management System",
  "developer": "rayhaanrakib.vercel.app",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "generate": "prisma generate",
    "build": "bun run generate && tsup",
    "dev": "tsx watch src/server.ts",
    "format:check": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "lint:check": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:deploy": "bunx prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "db:studio": "bunx prisma studio",
    "stripe:webhook": "stripe listen --forward-to https://bidyut-backend.vercel.app/api/v1/payments/webhook"
  },
  "keywords": [
    "Power Outage Management System",
    "Backend",
    "Prisma_PostgreSQL"
  ],
  "author": "Rayhan",
  "homepage": "https://github.com/rayhaanrakib/bidyut-backend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayhaanrakib/bidyut-backend.git"
  },
  "bugs": {
    "url": "https://github.com/rayhaanrakib/bidyut-backend/issues"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
